  "com.mandy.phoneagent": {
   "metadata": {
    "added": 1790253560,
    "categories": [
     "System"
    ],
    "lastUpdated": 1790328224,
    "license": "Proprietary",
    "sourceCode": "https://github.com/avanderberg48-collab/AccessiChat-WebApp-APK",
    "name": {
     "en-US": "Phone Agent"
    },
    "summary": {
     "en-US": "AI agent that controls your phone"
    },
    "description": {
     "en-US": "Phone Agent v4.5 (big SPEED update): a full Android AI agent. Tell it a task by voice or text and it reads the screen and performs the actions itself. v4.5 is about 10x faster: much smaller screen dumps, fastest AI model (GPT-OSS 20B) as default (about 1 second per step instead of up to 80), shorter wait times, smart rate limit handling. Own web browser: opens websites and Google searches by itself, reads page text, bookmarks, downloads. 200-step budget with pause and continue. Full coding support. Memory: knows your name and learns facts. Provider picker. English UI. Floating STOP button. No root. Android 12 (Nokia C12)."
    },
    "authorName": "Adrian Van der Berg",
    "authorWebSite": "https://github.com/avanderberg48-collab"
   },

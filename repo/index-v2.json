  "com.mandy.phoneagent": {
   "metadata": {
    "added": 1790253560,
    "categories": [
     "System"
    ],
    "lastUpdated": 1790316977,
    "license": "Proprietary",
    "sourceCode": "https://github.com/avanderberg48-collab/AccessiChat-WebApp-APK",
    "name": {
     "en-US": "Phone Agent"
    },
    "summary": {
     "en-US": "AI agent that controls your phone"
    },
    "description": {
     "en-US": "Phone Agent v4.3: a full Android AI agent like zerotap/Sova. Tell it a task by voice or text and it reads the screen and performs the actions itself. NEW IN 4.3: the agent has its own web browser \u2014 it opens websites and Google searches by itself (open_url), reads page text automatically, can save bookmarks (bookmark_add) and download files to Downloads/PhoneAgent (download). The browser also works by hand: address bar with Google search, back, forward, reload, home, bookmarks, read page aloud, downloads list, file uploads. Reliability kept from 4.2: waits patiently when the free AI is busy (no backend errors), scroll stuck detection, paced for long tasks. 200-step budget with pause and continue. Full coding (build apps in builders/editors/websites, paste up to 3000 chars). Memory: knows your name and learns facts. May type passwords in login forms. Choose the AI provider brain (Groq Qwen 3.8 default, GPT-OSS 120B/20B, or Gemini 3 Flash; automatic fallback). English UI, done popup, asks questions mid-task. Floating STOP button. No root. Works on Android 12 (Nokia C12)."
    },
    "authorName": "Adrian Van der Berg",
    "authorWebSite": "https://github.com/avanderberg48-collab"
   },

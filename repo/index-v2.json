  "com.opendroid.aiagent": {
   "metadata": {
    "name": {
     "en-US": "OpenDroid"
    },
    "summary": {
     "en-US": "Autonomous AI agent that controls your phone for you"
    },
    "description": {
     "en-US": "OpenDroid v1.0.7: the open-source autonomous AI agent for Android. Tell your phone in plain language what to do and it does it: opens apps, sends WhatsApp messages and SMS, calls contacts, sets alarms and timers, controls brightness, WiFi, Bluetooth, flashlight, reads the screen, and runs multi-step routines on its own. On-device, accessibility-driven. 12 AI providers built in including Groq (free) and Gemini (free tier), plus Ollama for fully offline use. Apache 2.0 open source, 1.1k stars on GitHub. English UI. Works on Android 8+, no root. Setup: grant Accessibility and Notification access, add your AI key in Settings (Groq recommended)."
    },
    "icon": {
     "en-US": {
      "name": "opendroid-icon.png",
      "sha256": "abbf2be1decde22fe5608ad1192eded9e42685d020fbc25752148fd91c5f18e4"
